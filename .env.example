# ==========================================
# ClimaSense AI - Environment Variables
# ==========================================
# NEVER commit your real .env file or API keys to GitHub!
# Copy this file to .env and insert your own keys for local development.

# --- SERVER-SIDE SECRETS (Required for AI Climate Assistant) ---
# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# This key is strictly used on the Node.js backend (server.ts) and is never sent to the browser.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Node.js Server Port (Defaults to 3000)
PORT=3000

# Application Public Base URL
APP_URL="http://localhost:3000"

# --- CLIENT-SIDE FIREBASE OVERRIDES (Optional) ---
# By default, Firebase parameters are loaded from firebase-applet-config.json.
# You can optionally override them via VITE_ prefixed environment variables:
# VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
# VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
# VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
# VITE_FIREBASE_DATABASE_ID="(default)"
# VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
# VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"

